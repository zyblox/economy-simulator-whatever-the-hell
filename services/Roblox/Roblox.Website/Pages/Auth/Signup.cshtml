@page "/auth/signup"
@model Roblox.Website.Pages.Auth.Signup

@{
    Layout = "Shared/_Layout";
}
<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-6 offset-md-3 col-lg-4 offset-lg-4">
            <div class="card card-body">
                <h2>Sign Up</h2>
                <p>To sign up, just enter a username and password.</p>
                <p>If you already have an account, you can <a href="/auth/login">login here</a>.</p>
                @if (Model.errorMessage != null)
                {
                    <p class="text-danger">@Model.errorMessage</p>
                }
                <form method="post">
                    <input disabled="@Model.signupDisabled" type="text" placeholder="Username" name="username" class="form-control mb-1"/>
                    <input disabled="@Model.signupDisabled" type="password" placeholder="Password" name="password" class="form-control mb-1"/>
                    <div class="h-captcha mt-4 mb-2" data-sitekey="@Model.siteKey" data-theme="light"></div>
                    @Html.AntiForgeryToken()
                    <input disabled="@Model.signupDisabled" class="btn btn-primary" type="submit" value="Sign Up" id="signup-submit"/>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://js.hcaptcha.com/1/api.js" async defer></script>
